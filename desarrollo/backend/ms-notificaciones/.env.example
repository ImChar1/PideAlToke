PROJECT_NAME="Microservicio de Notificaciones"
ENVIRONMENT="local"

# Validacion de JWT (Azure Entra ID): los endpoints exigen el rol ADMIN
AZURE_TENANT_ID="tenant-id-de-azure"
AZURE_CLIENT_ID="client-id-de-azure"

# --- RabbitMQ: ms-notificaciones es CONSUMIDOR de dos colas (cada una con su DLQ) ---
#   notificaciones.pedidos  <- pedidos.events (topic)    rk pedido.confirmado / pedido.cancelado
#   alertas.stock           <- pidealtoke.alertas (direct) rk stock.bajo
# Apagado por defecto (tests / uvicorn local sin broker). docker compose lo enciende.
RABBITMQ_ENABLED="false"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_USER="admin"
RABBITMQ_PASSWORD="admin123"
# Nombres de exchanges/colas/bindings (valores por defecto en app/core/config.py)
