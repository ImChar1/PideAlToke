PROJECT_NAME="Microservicio de Analitica"
ENVIRONMENT="local"

# Validacion de JWT (Azure Entra ID): los endpoints exigen el rol ADMIN
AZURE_TENANT_ID="tenant-id-de-azure"
AZURE_CLIENT_ID="client-id-de-azure"

# --- Kafka: ms-analitica es CONSUMIDOR de pedidos.eventos y de inventario.movimientos ---
# Apagado por defecto (tests / uvicorn local sin cluster). docker compose lo enciende.
KAFKA_ENABLED="false"
KAFKA_BOOTSTRAP_SERVERS="localhost:9092,localhost:9093,localhost:9094"
# Opcionales (valores por defecto en app/core/config.py): KAFKA_TOPIC_PEDIDOS, KAFKA_TOPIC_MOVIMIENTOS,
# KAFKA_GROUP_VENTAS, KAFKA_GROUP_STOCK, KAFKA_CONSUMER_CONCURRENCY, KAFKA_MAX_RETRIES, KAFKA_REBUILD_ON_START
