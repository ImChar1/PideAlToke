PROJECT_NAME="Microservicio de Pedidos"
ENVIRONMENT="local"
DATABASE_URL="sqlite:///./pedidos.db"

AZURE_TENANT_ID="tenant-id-de-azure"
AZURE_CLIENT_ID="client-id-de-azure"

# URL de ms-inventario para reservar/liberar stock al crear un pedido
INVENTARIO_SERVICE_URL="http://localhost:8003"

# URL de ms-catalogo para consultar el precio real de cada producto al crear un pedido
CATALOGO_SERVICE_URL="http://localhost:8002"

# Clave compartida con ms-inventario (debe ser identica en ambos servicios)
INTERNAL_API_KEY="cambia-esta-clave-interna"

# --- RabbitMQ (opcional): ms-pedidos publica eventos pedido.creado / confirmado / cancelado ---
# Apagado por defecto. Para probar en local: docker compose up rabbitmq (desde desarrollo/)
RABBITMQ_ENABLED="false"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_USER="admin"
RABBITMQ_PASSWORD="admin123"
# Opcionales (valores por defecto en app/core/config.py): RABBITMQ_EXCHANGE_PEDIDOS,
# RABBITMQ_RK_PEDIDO_CREADO / _CONFIRMADO / _CANCELADO. Si los cambias, cambialos igual en ms-inventario.
