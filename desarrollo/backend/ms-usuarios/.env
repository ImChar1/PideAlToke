PROJECT_NAME="Microservicio de Usuarios"
ENVIRONMENT="local"

# Conexión local en MariaDB / MySQL
DATABASE_URL="mysql+pymysql://root:rootpassword@localhost:3306/usuarios_db"

# Para pruebas rápidas con SQLite local:
# DATABASE_URL="sqlite:///./usuarios.db"

# Credenciales de Azure Entra ID
AZURE_TENANT_ID="tu-tenant-id-de-azure"
AZURE_CLIENT_ID="tu-client-id-de-azure"

# Comunicación interna entre contenedores Docker
USUARIOS_SERVICE_URL="http://localhost:8001"
