PROJECT_NAME="Microservicio de Administracion de Kafka"
ENVIRONMENT="local"

# Validacion de JWT (Azure Entra ID): todos los endpoints exigen el rol ADMIN
AZURE_TENANT_ID="tenant-id-de-azure"
AZURE_CLIENT_ID="client-id-de-azure"

# Brokers del cluster (con docker compose se inyectan solos: kafka1:29092,kafka2:29092,kafka3:29092)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092,localhost:9093,localhost:9094"
KAFKA_REQUEST_TIMEOUT_SECONDS="10"
