PROJECT_NAME="Microservicio de Inventario"
ENVIRONMENT="local"
# Base local para pruebas rapidas (sin Docker). Con docker compose se inyecta DATABASE_URL automaticamente.
DATABASE_URL="sqlite:///./inventario.db"

AZURE_TENANT_ID="tenant-id-de-azure"
AZURE_CLIENT_ID="client-id-de-azure"

# Clave compartida con ms-pedidos para reservar / liberar / confirmar-salida (debe ser identica en ambos)
INTERNAL_API_KEY="cambia-esta-clave-interna"

# --- RabbitMQ (opcional): ms-inventario consume los eventos pedido.* publicados por ms-pedidos ---
# Apagado por defecto. Para probar en local: docker compose up rabbitmq (desde desarrollo/)
RABBITMQ_ENABLED="false"
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_USER="admin"
RABBITMQ_PASSWORD="admin123"
# Consumo: prefetch por consumidor, hilos y reintentos con backoff exponencial antes de enviar a la DLQ
RABBITMQ_CONSUMER_PREFETCH="10"
RABBITMQ_CONSUMER_CONCURRENCY="2"
RABBITMQ_MAX_RETRIES="3"
RABBITMQ_RETRY_BASE_SECONDS="1"
RABBITMQ_RETRY_MAX_SECONDS="30"
# Nombres de exchanges/colas (valores por defecto en app/core/config.py): RABBITMQ_EXCHANGE_PEDIDOS,
# RABBITMQ_EXCHANGE_DLX, RABBITMQ_QUEUE_PEDIDOS, RABBITMQ_QUEUE_PEDIDOS_DLQ, RABBITMQ_BINDING_PEDIDOS.
