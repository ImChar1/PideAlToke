PROJECT_NAME="Microservicio de Mensajeria"
ENVIRONMENT="local"

# Validacion de JWT (Azure Entra ID): todos los endpoints exigen el rol ADMIN
AZURE_TENANT_ID="tenant-id-de-azure"
AZURE_CLIENT_ID="client-id-de-azure"

# Conexion a RabbitMQ (con docker compose se inyectan solas: host "rabbitmq")
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_VHOST="/"
RABBITMQ_USER="admin"
RABBITMQ_PASSWORD="admin123"
