# Copia este archivo a ".env" (cp .env.example .env). Los valores por defecto
# sirven para levantar todo en local con docker compose sin tocar nada.

# --- Base de datos (MariaDB) ---
# Root: SOLO administracion de la base. Ningun microservicio se conecta con este usuario.
DB_ROOT_PASSWORD=rootpassword
# Un usuario de BD por microservicio, con permisos unicamente sobre su propia base.
# Usa valores distintos y SIN caracteres especiales (van dentro de una URL de conexion);
# por ejemplo: openssl rand -hex 16
DB_PASS_USUARIOS=cambia-esta-clave-usuarios
DB_PASS_CATALOGO=cambia-esta-clave-catalogo
DB_PASS_INVENTARIO=cambia-esta-clave-inventario
DB_PASS_PEDIDOS=cambia-esta-clave-pedidos
DB_HOST=db
DB_PORT=3306
DB_NAME_USUARIOS=usuarios_db
DB_NAME_CATALOGO=catalogo_db
DB_NAME_INVENTARIO=inventario_db
DB_NAME_PEDIDOS=pedidos_db

# --- Azure Entra ID (mismos valores que environment.ts) ---
AZURE_TENANT_ID=ea69d1fe-64a8-46fa-a274-47a2f05244ad
AZURE_CLIENT_ID=f3e5ef16-7ccb-4c9f-bfdd-2b965ecec91d

# --- Clave compartida SOLO entre microservicios (ms-pedidos -> ms-inventario) ---
# Protege reservar / liberar / confirmar-salida. Cambiala por un valor largo y aleatorio.
INTERNAL_API_KEY=cambia-esta-clave-interna-por-una-larga-y-aleatoria

# --- RabbitMQ (mensajeria entre microservicios) ---
# Credenciales del broker. Los valores por defecto son SOLO para desarrollo local; en cualquier
# otro entorno cambialas. Si no las defines, compose usa admin / admin123.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# --- Puertos publicados en tu maquina (cambialos si hay conflicto) ---
PORT_DB=3306
PORT_MS_USUARIOS=8001
PORT_MS_CATALOGO=8002
PORT_MS_INVENTARIO=8003
PORT_MS_PEDIDOS=8004
PORT_GATEWAY=8080
PORT_FRONTEND=4200
PORT_MS_MENSAJERIA=8005
# RabbitMQ solo se publica en 127.0.0.1 (AMQP y consola web http://localhost:15672)
PORT_RABBITMQ=5672
PORT_RABBITMQ_UI=15672
